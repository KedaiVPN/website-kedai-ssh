# ===============================================================
# DATABASE CONFIGURATION (MySQL)
# ===============================================================
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=your_database_name
DB_PORT=3306

# ===============================================================
# SERVER & APP CONFIGURATION
# ===============================================================
PORT=3001
FRONTEND_URL=http://localhost:8080
# IMPORTANT: Set this to your actual backend domain for production
BACKEND_URL=http://localhost:3001

# ===============================================================
# SECURITY & SESSION CONFIGURATION
# ===============================================================
# A long, random string for signing JWT tokens
JWT_SECRET=rahasia_super_aman_untuk_jwt_!@#$
# A different long, random string for signing session cookies
SESSION_SECRET=rahasia_super_aman_untuk_session_%^&*
JWT_EXPIRES_IN=7d

# ===============================================================
# CLOUDFLARE TURNSTILE CONFIGURATION
# ===============================================================
TURNSTILE_SECRET_KEY=0x4AAAAAAB66SrTqbISHpQBudmfJPwJd7UY

# ===============================================================
# GOOGLE OAUTH CONFIGURATION
# ===============================================================
GOOGLE_CLIENT_ID=isi_dari_console_google
GOOGLE_CLIENT_SECRET=isi_dari_console_google  
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

