
# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:8080

# Backend URL - IMPORTANT: Set this to your actual backend domain for production
BACKEND_URL=http://localhost:3001

# JWT Configuration  
JWT_SECRET=rahasia_super_aman
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=isi_dari_console_google
GOOGLE_CLIENT_SECRET=isi_dari_console_google  
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Email Configuration (SMTP)
# Email Configuration (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM=KedaiSSH <verifikasi@kedaivpn.my.id>

# Admin Configuration
ADMIN_DEFAULT_PASSWORD=admin123

# Environment Configuration
# For sandbox testing: NODE_ENV=development (or leave unset)
# For production: NODE_ENV=production
# NODE_ENV=development

# Duitku Payment Gateway Configuration (Updated API)
# Get these from your Duitku merchant dashboard
# Merchant Code format: DS##### (e.g., DS24293)
DUITKU_MERCHANT_CODE=your_merchant_code_here
DUITKU_API_KEY=your_api_key_here

# Optional: Override Duitku API endpoint explicitly
# Leave empty to use automatic sandbox/production detection based on NODE_ENV
# DUITKU_BASE_URL=https://api-sandbox.duitku.com/api

# API Endpoints (Updated):
# Sandbox API: https://api-sandbox.duitku.com/api
# Production API: https://api-prod.duitku.com/api

# IMPORTANT FOR DEPLOYMENT: 
# 1. Set BACKEND_URL to your actual backend domain (not localhost)
# 2. Set FRONTEND_URL to your actual frontend domain (not localhost) 
# 3. Make sure your merchant code and API key are correct for the environment
# 4. Test with sandbox first before switching to production
# 5. New API uses header-based authentication with SHA256 signature
# 6. Jakarta timezone timestamp is required in milliseconds

# Authentication Method:
# - Headers: x-duitku-signature, x-duitku-timestamp, x-duitku-merchantcode
# - Signature: SHA256(merchantCode + " - " + timestamp + " - " + apiKey)
# - No signature in request body anymore

# For production deployment, make sure to set:
# NODE_ENV=production
# BACKEND_URL=https://kedaivpn.my.id
# FRONTEND_URL=https://kedaivpn.my.id
# DUITKU_MERCHANT_CODE=your_production_merchant_code
# DUITKU_API_KEY=your_production_api_key
